# EdenMish Shopify — environment template
# Copy this file to ".env" and fill in real values. ".env" is gitignored — never commit it.

# Store
SHOPIFY_STORE=edenmish.myshopify.com
SHOPIFY_API_VERSION=2026-04

# Option A — Theme CLI access (for editing the Dawn theme code)
# Get it from the "Theme Access" app in the store admin (token starts with shptka_).
# Lets `shopify theme pull/dev/push` run non-interactively.
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B — Admin API access (for scripts that read/write products, orders, etc.)
# Get it from a custom app's "API credentials" page in the store admin (token starts with shpat_).
# Used as the "X-Shopify-Access-Token" HTTP header in curl/scripts.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom app client id (public, safe to keep). Do NOT store the app secret (shpss_) in env files.
SHOPIFY_APP_CLIENT_ID=9dee3c06dc23f24068bbf4772f7023aa
