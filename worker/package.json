{
  "name": "edenmish-ops",
  "version": "0.1.0",
  "private": true,
  "description": "EdenMish delivery order + tracking backend (Cloudflare Worker + D1)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test \"tests/**/*.test.js\"",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute edenmish --file=./schema.sql",
    "db:query": "wrangler d1 execute edenmish --command"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "qrcode-generator": "^1.4.4"
  }
}
