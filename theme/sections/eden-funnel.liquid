{{ 'eden-funnel.css' | asset_url | stylesheet_tag }}

<section
  class="eden-funnel"
  dir="rtl"
  data-edon-funnel
  data-whatsapp="{{ section.settings.whatsapp_number | default: '972534058498' | remove: '+' | remove: ' ' | remove: '-' }}"
  data-price-base="{{ section.settings.price_base | default: 59 }}"
  data-price-per-km="{{ section.settings.price_per_km | default: 4 }}"
  data-storefront-token="{{ section.settings.storefront_token | default: '' }}"
>
  {%- comment -%} ---------------- HERO ---------------- {%- endcomment -%}
