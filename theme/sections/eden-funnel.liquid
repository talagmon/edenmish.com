            <span>שם מלא</span>
            <input type="text" name="name" required autocomplete="name">
          </label>
          <label class="ef-field">
            <span>טלפון</span>
      <input type="tel" name="phone" required autocomplete="tel" inputmode="tel">
    </label>
  </div>

        <label class="ef-field">
          <span>דוא״ל (לחשבונית ואישור מסירה — אופציונלי, ניתן גם בקופה)</span>
