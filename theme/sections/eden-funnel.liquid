<script>
  var EDEN_ZONES = ['תל אביב','תל אביב-יפו','תל אביב יפו','רמת גן','גבעתיים','בני ברק','הרצליה','רמת השרון','הוד השרון','קריית אונו','קרית אונו','גבעת שמואל','אור יהודה','בת ים','חולון','ראשון לציון','כפר סבא','רעננה','פתח תקווה','אזור','גני תקווה','סביון','רמלה','לוד'];
  var EDEN_ZONE_ERR = function(el, msg) {
    el.value = ''; delete el.dataset.parsed; delete el.dataset.city; delete el.dataset.lat; delete el.dataset.lng;
    var err = el.parentNode.querySelector('.ef-zone-err');
    if (!err) { err = document.createElement('div'); err.className = 'ef-zone-err'; err.style.cssText = 'color:#C0392B;font-size:.85rem;margin-top:4px'; el.parentNode.appendChild(err); }
    err.textContent = msg; el.style.borderColor = '#C0392B';
  };
  (function () {
    var root = document.currentScript.previousElementSibling;
    document.querySelectorAll('[data-edon-funnel]').forEach(function (section) {
      if (section.dataset.efBound) return;
      section.dataset.efBound = '1';
      var form = section.querySelector('[data-ef-form]');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        var pickupIn = form.querySelector('[name="pickup"]');
        var dropoffIn = form.querySelector('[name="dropoff"]');
        if (pickupIn && pickupIn.dataset.city && EDEN_ZONES.indexOf(pickupIn.dataset.city) < 0) { EDEN_ZONE_ERR(pickupIn, 'אזור מחוץ לטווח השירות.'); pickupIn.focus(); return; }
        if (dropoffIn && dropoffIn.dataset.city && EDEN_ZONES.indexOf(dropoffIn.dataset.city) < 0) { EDEN_ZONE_ERR(dropoffIn, 'אזור מחוץ לטווח השירות.'); dropoffIn.focus(); return; }
        var num = (section.dataset.whatsapp || '').replace(/\D/g, '');
        var v = function (n) { return (form.querySelector('[name="' + n + '"]') || {}).value || ''; };
        function addrLine(addr, det) {
          var el = form.querySelector('[name="' + addr + '"]');
          var base = (el && el.dataset.parsed) || (el && el.value) || '';
          var d = v(det);
          return base + (d ? ' | ' + d : '');
        }
        function num2(addr, k) { var el = form.querySelector('[name="' + addr + '"]'); return el && el.dataset[k] ? Number(el.dataset[k]) : null; }
        var estimate = section.dataset.estimate || '';
        var msg =
          'שלום עדן, התקבלה בקשה חדשה:\n' +
          'שם: ' + v('name') + '\n' +
          'דוא״ל: ' + v('email') + '\n' +
          'טלפון: ' + v('phone') + '\n' +
          'סוג לקוח: ' + v('customer_type') + '\n' +
          'איסוף: ' + addrLine('pickup', 'pickup_detail') + '\n' +
          'מסירה: ' + addrLine('dropoff', 'dropoff_detail') + '\n' +
          'מועד: ' + v('when') + '\n' +
          'חבילה: ' + v('package') + '\n' +
          'דחוף: ' + v('urgent') + '\n' +
          (estimate ? 'הערכה: ' + estimate + '\n' : '') +
          'הערות: ' + v('notes');
        var pickupEl2 = form.querySelector('[name="pickup"]');
        var dropoffEl2 = form.querySelector('[name="dropoff"]');
        var payload = {
          name: v('name'), email: v('email'), phone: v('phone'), customer_type: v('customer_type'),
          pickup: addrLine('pickup', ''), pickup_detail: v('pickup_detail'),
          pickup_city: (pickupEl2 && pickupEl2.dataset.city) || '', pickup_lat: num2('pickup', 'lat'), pickup_lng: num2('pickup', 'lng'),
          dropoff: addrLine('dropoff', ''), dropoff_detail: v('dropoff_detail'),
          dropoff_city: (dropoffEl2 && dropoffEl2.dataset.city) || '', dropoff_lat: num2('dropoff', 'lat'), dropoff_lng: num2('dropoff', 'lng'),
          when_text: v('when'), package: v('package'), urgent: v('urgent') === 'דחוף', notes: v('notes'),
          distance_km: section.dataset.distance ? Number(section.dataset.distance) : null
        };
        var btn = form.querySelector('[type="submit"]');
        if (btn) { btn.disabled = true; btn.dataset.label = btn.textContent; btn.textContent = 'טוען…'; }
        var orderData = null;
        fetch('https://find.edenmish.com/api/orders', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
        }).then(function (r) { return r.json(); }).then(function (d) {
          orderData = d;
          if (!d || !d.token) throw new Error('no order');
          if (d.review) { window.location.href = d.tracking_url; return; }
          // PR4 — Draft Order payment path: the Worker created a Shopify Draft Order and
          // returned its invoice URL (d.payment_url). Redirect there to pay via Shopify +
          // PayPlus. If no payment_url (Shopify not configured / charge failed), fall back
          // to the tracking page, which shows a pay button or manual-coordination option.
          window.location.href = d.payment_url || d.tracking_url;
        }).catch(function () {
          if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label || 'המשך לתשלום מאובטח'; }
          if (orderData && orderData.tracking_url) { window.location.href = orderData.tracking_url; }
          else if (num) { window.open('https://wa.me/' + num + '?text=' + encodeURIComponent(msg), '_blank'); }
          else { alert('שגיאה. נסו שוב או כתבו לנו בוואטסאפ.'); }
        });
      });
    });
  })();

  function initEdenAutocomplete() {
    document.querySelectorAll('[data-edon-funnel]').forEach(function (section) {
      if (section.dataset.acBound) return;
      section.dataset.acBound = '1';
      var pickupEl = section.querySelector('[data-ef-addr="pickup"]');
      var dropoffEl = section.querySelector('[data-ef-addr="dropoff"]');
      if (!pickupEl || !dropoffEl || !window.google || !google.maps || !google.maps.places) return;
      var opt = {
        componentRestrictions: { country: 'il' },
        fields: ['formatted_address', 'geometry', 'name', 'address_components'],
        types: ['geocode'],
        bounds: { north: 32.20, south: 31.90, east: 34.95, west: 34.70 },
        strictBounds: true
      };
      var ZONES = EDEN_ZONES;
      function zoneError(el, msg) { EDEN_ZONE_ERR(el, msg); }
      function zoneOk(el) {
        var err = el.parentNode.querySelector('.ef-zone-err'); if (err) err.remove();
        el.style.borderColor = '';
      }
      function checkZone(p, el) {
        if (!p || !p.address_components) return true;
        var city = '';
        (p.address_components || []).forEach(function (c) {
          var t = c.types || [];
          if (t.indexOf('locality') >= 0 || t.indexOf('administrative_area_level_2') >= 0) city = city || c.long_name;
        });
        if (city && ZONES.indexOf(city) < 0) { zoneError(el, 'מצטערים, איננו משרתים את האזור ' + city + '. אזורי השירות: תל אביב, גוש דן והסביבה.'); return false; }
        zoneOk(el); return true;
      }
      var a = new google.maps.places.Autocomplete(pickupEl, opt);
      var b = new google.maps.places.Autocomplete(dropoffEl, opt);
      var est = section.querySelector('[data-ef-estimate]');
      var form = section.querySelector('[data-ef-form]');
      if (!form) return;
      function parsePlace(p) {
        if (!p || !p.address_components) return (p && p.formatted_address) || '';
        var street = '', num = '', city = '';
        (p.address_components || []).forEach(function (c) {
          var t = c.types || [];
          if (t.indexOf('route') >= 0) street = c.long_name;
          if (t.indexOf('street_number') >= 0) num = c.long_name;
          if (t.indexOf('locality') >= 0 || t.indexOf('administrative_area_level_2') >= 0) city = city || c.long_name;
        });
        var base = (street ? street : '') + (num ? ' ' + num : '');
        var full = base + (city ? ', ' + city : '');
        return full || p.formatted_address || '';
      }
      function placeCity(p) {
        if (!p || !p.address_components) return '';
        var city = '';
        (p.address_components || []).forEach(function (c) {
          var t = c.types || [];
          if (t.indexOf('locality') >= 0 || t.indexOf('administrative_area_level_2') >= 0) city = city || c.long_name;
        });
        return city;
      }
      function storePlace(el, p) {
        if (!checkZone(p, el)) return false;
        el.dataset.parsed = parsePlace(p);
        el.dataset.city = placeCity(p);
        if (p && p.geometry && p.geometry.location) {
          el.dataset.lat = p.geometry.location.lat();
          el.dataset.lng = p.geometry.location.lng();
        }
        return true;
      }
      function calc() {
        var p1 = a.getPlace(), p2 = b.getPlace();
        var ok1 = true, ok2 = true;
        if (p1) ok1 = storePlace(pickupEl, p1);
        if (p2) ok2 = storePlace(dropoffEl, p2);
        if (!ok1 || !ok2) { delete section.dataset.distance; if (est) est.hidden = true; return; }
        if (p1 && p1.geometry && p2 && p2.geometry) {
          new google.maps.DistanceMatrixService().getDistanceMatrix({
            origins: [p1.geometry.location], destinations: [p2.geometry.location],
            travelMode: 'DRIVING', unitSystem: google.maps.UnitSystem.METRIC
          }, function (res, status) {
            if (status === 'OK' && res && res.rows[0] && res.rows[0].elements[0] && res.rows[0].elements[0].status === 'OK') {
              var e = res.rows[0].elements[0];
              var km = e.distance.value / 1000;
              section.dataset.distance = km.toFixed(2);
              var price = estimatePrice(section, form, km);
              if (est) {
                est.hidden = false;
                est.innerHTML = 'מרחק נסיעה ~' + e.distance.text + ' • <strong>הערכת מחיר: ₪' + price + '</strong> <span>(המחיר הסופי מאושר בדף המעקב)</span>';
                section.dataset.estimate = 'מרחק ~' + e.distance.text + ', מחיר מוערך ₪' + price;
              }
            }
          });
        } else {
          recalcEstimate(section, form);
        }
      }
      function recalcEstimate(sec, frm) {
        var km = sec.dataset.distance ? parseFloat(sec.dataset.distance) : null;
        if (km == null) return;
        var price = estimatePrice(sec, frm, km);
        if (est && price) { est.hidden = false; est.innerHTML = est.innerHTML.replace(/₪\d+/, '₪' + price); sec.dataset.estimate = 'מחיר מוערך ₪' + price; }
      }
      form.querySelector('[name="package"]').addEventListener('change', function () { recalcEstimate(section, form); });
      form.querySelector('[name="urgent"]').addEventListener('change', function () { recalcEstimate(section, form); });
      google.maps.event.addListener(a, 'place_changed', calc);
      google.maps.event.addListener(b, 'place_changed', calc);
    });
  }
  function estimatePrice(section, form, km) {
    var pkgBases = { 'מעטפה/מסמך': 59, 'פריט קטן': 69, 'קופסה (עד גודל נעל)': 89 };
    var pkgSel = form.querySelector('[name="package"]');
    var base = (pkgSel && pkgBases[pkgSel.value]) || parseFloat(section.dataset.priceBase || 59);
    var perKm = parseFloat(section.dataset.pricePerKm || 4);
    var includedKm = 3;
    var isUrgent = ((form.querySelector('[name="urgent"]') || {}).value === 'דחוף');
    return Math.round((base + Math.max(0, km - includedKm) * perKm) * (isUrgent ? 1.25 : 1));
  }
</script>
{% if section.settings.google_maps_key != blank %}
<script src="https://maps.googleapis.com/maps/api/js?key={{ section.settings.google_maps_key }}&libraries=places&language=iw&region=il&callback=initEdenAutocomplete" async defer></script>
{% endif %}

