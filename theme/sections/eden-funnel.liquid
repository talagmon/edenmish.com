    {%- if section.settings.hero_image != blank -%}
      style="background: linear-gradient(135deg, rgba(62, 29, 94, 0.88), rgba(91, 42, 134, 0.82)), url('{{ section.settings.hero_image | image_url: width: 2000 }}') center/cover no-repeat;"
    {%- endif -%}
  >
    <div class="page-width">
      <h1 class="ef-hero__title">{{ section.settings.hero_title }}</h1>
      <p class="ef-hero__sub">{{ section.settings.hero_subtitle }}</p>
